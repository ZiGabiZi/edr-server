__pycache__/
*.pyc
.venv/
.env
*.db
# Fisierele auxiliare ale modului WAL. *.db nu le prinde: SQLite le
# numeste <baza>.db-wal si <baza>.db-shm, iar cel de-al doilea sufix
# scoate numele din gluma *.db. Jurnalul WAL contine evenimente inca
# necomise in fisierul principal, deci nu e un temporar oarecare.
*.db-wal
*.db-shm

# Baza de lucru a instantaneului de reputatie. Nu e <ceva>.db, deci *.db
# nu o prinde: reputation_build.py o numeste <iesire>.build si o sterge
# singur la final. Ramane pe disc doar daca importul e omorat la mijloc,
# iar atunci sunt zeci de GB pe care nimeni nu vrea sa-i vada in git add -A.
*.build
*.build-wal
*.build-shm
*.log
logs/
*.swp
.vscode/
.claude/

# Secrete de autentificare - nu au ce cauta in istoric sau in backup-uri partajate
enrollment_secret.txt
agent_keys.json
agent_keys.json.tmp
